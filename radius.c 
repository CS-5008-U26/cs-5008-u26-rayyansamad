/* radius.c
 * Accepts an integer radius and prints the integer area of a circle.
 * Uses the math library to get a precise value of pi.
 *
 * Formula: area = pi * radius^2
 *
 * Name: Rayyan Samad
 * CS-5008 Summer 2026
 */

#include <stdio.h>
#include <math.h>

int main() {

    int radius;     /* radius entered by the user */
    double pi;      /* value of pi from the math library */
    int area;       /* integer approximation of the circle's area */

    /* acos(-1) is the standard way to get pi in C */
    pi = acos(-1);

    printf("Enter an integer radius: ");
    scanf("%d", &radius);

    /* cast the result to int to get the integer approximation */
    area = (int)(pi * radius * radius);

    printf("For a circle of radius %d the area is %d\n", radius, area);

    return 0;
}